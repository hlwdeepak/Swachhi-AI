# SWACHHAI AI — Environment Variables
# Copy this to .env.local and fill in values for production.
# The app works fully in Demo Mode without any of these.

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=swachhai-dev-secret-change-in-production-use-256-bit-random

# ─── IBM watsonx.ai (optional — app uses Demo AI if not set) ─────────────────
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_API_KEY=your_ibm_cloud_api_key
# WATSONX_PROJECT_ID=your_project_id
# GRANITE_MODEL=ibm/granite-13b-instruct-v2

# ─── Database path (defaults to ./data/swachhai.db) ─────────────────────────
# DB_PATH=./data/swachhai.db
